{
  "name": "clinic-booking-prototype",
  "version": "1.0.0",
  "description": "Clinic Booking System with Patient and Doctor views",
  "main": "server.js",
  "scripts": {
    "build": "tsc",
    "start": "node server.js",
    "dev": "concurrently -k -n TS,SRV -c cyan,green \"tsc --watch --preserveWatchOutput\" \"nodemon --watch server.js --watch app.js server.js\"",
    "dev:build": "tsc && node server.js",
    "dev:server": "nodemon server.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "nodemon": "^3.1.11",
    "typescript": "^5.3.0"
  }
}
